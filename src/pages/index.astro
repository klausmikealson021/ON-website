---
import BaseLayout from '../layouts/BaseLayout.astro';

const channelUrl = 'https://t.me/+__qCxFVxReFkMTI0';
const supportUrl = 'https://t.me/mikealson_og';

const faqs = [
  {
    q: 'آیا ثبت درخواست در سایت به معنی خرید قطعی است؟',
    a: 'خیر. سایت فقط اطلاعات اولیه درخواست را آماده می‌کند. درخواست زمانی به پشتیبانی می‌رسد که خودتان پیام را در تلگرام ارسال کنید و پس از بررسی و توافق، سفارش توسط پشتیبانی پذیرفته شود.'
  },
  {
    q: 'قیمت نهایی و روش پرداخت را از کجا دریافت می‌کنم؟',
    a: 'قیمت نهایی، روش پرداخت و شرایط تحویل در گفت‌وگوی تلگرام و پس از بررسی درخواست اعلام می‌شود. در این مرحله پرداختی داخل سایت انجام نمی‌شود.'
  },
  {
    q: 'برای ثبت درخواست چه اطلاعاتی لازم است؟',
    a: 'فقط اطلاعات اولیه محصول و نام کاربری تلگرام مقصد لازم است. پیش از ارسال پیام، اطلاعات انتخاب‌شده را بازبینی کنید.'
  },
  {
    q: 'آیا باید رمز عبور یا کد ورود تلگرام را بدهم؟',
    a: 'خیر. رمز عبور، کد ورود و کد تأیید تلگرام را در سایت یا برای اشخاص ارسال نکنید. این اطلاعات برای ثبت درخواست لازم نیست.'
  }
];

const reviewSlots = [
  'جایگاه بازخورد خرید Premium',
  'جایگاه بازخورد خرید Stars',
  'جایگاه تجربه ثبت درخواست',
  'جایگاه تجربه ارتباط با پشتیبانی',
  'جایگاه تجربه فرایند تحویل',
  'جایگاه بازخورد مشتریان',
  'جایگاه تجربه تأییدشده دیگر'
];

const articles = [
  { category: 'راهنمای محصول', title: 'Telegram Premium؛ امکانات و نکاتی که باید بدانید', number: '01', tone: 'article-art--premium' },
  { category: 'راهنمای محصول', title: 'Telegram Stars چیست و کجا استفاده می‌شود؟', number: '02', tone: 'article-art--stars' },
  { category: 'امنیت و راهنما', title: 'هنگام ثبت درخواست تلگرام، از چه اطلاعاتی محافظت کنیم؟', number: '03', tone: 'article-art--security' }
];
---

<BaseLayout
  title="ORIGINAL NET | دسترسی آسان، با اطمینان"
  description="خدمات منتخب تلگرام با مسیر درخواست روشن، ارتباط مستقیم و پشتیبانی ORIGINAL NET."
>
  <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>

  <header class="site-header">
    <div class="header-shell container">
      <a class="brand" href="/" aria-label="ORIGINAL NET، صفحه اصلی">
        <span class="brand-name" dir="ltr">ORIGINAL NET</span>
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-label="باز کردن منو"
        aria-expanded="false"
        aria-controls="primary-navigation"
        data-menu-toggle
      >
        <span></span><span></span><span></span>
      </button>

      <nav class="main-nav" id="primary-navigation" aria-label="منوی اصلی" data-main-nav>
        <a href="#services">محصولات</a>
        <a href="#articles">آموزش‌ها</a>
        <a href="#trust">اعتماد و تجربه</a>
        <a href="#why-original">درباره ما</a>
        <a href={supportUrl} target="_blank" rel="noopener noreferrer">پشتیبانی</a>
      </nav>

      <!-- در فاز اول این CTA مستقیماً به کانال می‌رود؛ منوی شبکه‌های اجتماعی برای مرحله بعد محفوظ است. -->
      <a class="button button-primary header-cta" href={channelUrl} target="_blank" rel="noopener noreferrer" data-channel-cta>
        مشاهده محصولات
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </header>

  <main id="main-content">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> ORIGINAL NET <span class="eyebrow-divider">/</span> خدمات منتخب تلگرام</p>
          <h1 id="hero-title">دسترسی آسان،<br /><span>با اطمینان.</span></h1>
          <p class="hero-description">
            برای استفاده از خدمات منتخب تلگرام، مسیر روشن‌تری داشته باشید. محصول موردنظرتان را انتخاب کنید، اطلاعات اولیه را بررسی کنید و ادامه هماهنگی را مستقیم با پشتیبانی انجام دهید.
          </p>
          <div class="hero-actions">
            <a class="button button-primary button-large" href={channelUrl} target="_blank" rel="noopener noreferrer" data-channel-cta>
              مشاهده محصولات <span aria-hidden="true">↗</span>
            </a>
            <a class="button button-ghost button-large" href={supportUrl} target="_blank" rel="noopener noreferrer">
              ارتباط با پشتیبانی <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="hero-note"><span class="status-dot"></span> درخواست اولیه در سایت؛ قیمت نهایی و هماهنگی در تلگرام</p>
        </div>

        <div class="hero-visual-wrap">
  <div class="hero-visual hero-video-frame">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src="/media/hero.mp4" type="video/mp4" />
    </video>

    <div class="hero-video-overlay" aria-hidden="true"></div>

    <span class="visual-label visual-label-top">
      BRAND MOTION / 01
    </span>

    <span class="visual-label visual-label-bottom">
      ORIGINAL NET / CINEMATIC EXPERIENCE
    </span>

    <span class="visual-corner visual-corner-one" aria-hidden="true"></span>
    <span class="visual-corner visual-corner-two" aria-hidden="true"></span>
  </div>

  <div class="hero-visual-caption">
    <span>01 — تجربه دیجیتال</span>
    <span>ORIGINAL NET</span>
  </div>
</div>
      </div>
      <div class="hero-bottom-line container" aria-hidden="true"><span></span><span>SCROLL TO EXPLORE</span><span></span></div>
    </section>

    <section class="section section-services" id="services" aria-labelledby="services-title">
      <div class="container">
        <div class="section-heading section-heading-split">
          <div>
            <p class="section-kicker">01 / SERVICES</p>
            <h2 id="services-title">خدمات منتخب</h2>
            <p class="section-intro">در فاز اول، دو مسیر درخواست فعال و مشخص پیش روی شماست.</p>
          </div>
          <span class="section-index">02 <i>/ 09</i></span>
        </div>

        <div class="service-grid">
          <article class="service-card service-card-premium">
            <div class="service-card-topline"><span>01 / SUBSCRIPTION</span><span class="service-card-mark" aria-hidden="true">✳</span></div>
            <div class="service-art service-art-premium media-placeholder" role="img" aria-label="جایگاه ویدئوی معرفی Telegram Premium">
              <div class="premium-rings" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="premium-gem" aria-hidden="true"><span>P</span></div>
              <span class="service-art-caption">PREMIUM MOTION SLOT</span>
            </div>
            <div class="service-card-content">
              <p class="service-category">اشتراک تلگرام</p>
              <h3>Telegram Premium</h3>
              <p>انتخاب اشتراک ۳، ۶ یا ۱۲ ماهه و ارسال درخواست برای حساب تلگرام موردنظر.</p>
              <a class="text-link" href={channelUrl} target="_blank" rel="noopener noreferrer" data-channel-cta>
                جزئیات و درخواست <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>

          <article class="service-card service-card-stars">
            <div class="service-card-topline"><span>02 / DIGITAL GOODS</span><span class="service-card-mark" aria-hidden="true">✦</span></div>
            <div class="service-art service-art-stars media-placeholder" role="img" aria-label="جایگاه ویدئوی معرفی Telegram Stars">
              <div class="stars-field" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
              <div class="star-emblem" aria-hidden="true">★</div>
              <span class="service-art-caption">STARS MOTION SLOT</span>
            </div>
            <div class="service-card-content">
              <p class="service-category">اعتبار و هدیه دیجیتال</p>
              <h3>Telegram Stars</h3>
              <p>انتخاب بسته پیشنهادی یا واردکردن تعداد دلخواه در بازه ۱۰۰ تا ۱۰٬۰۰۰٬۰۰۰ استارز.</p>
              <a class="text-link" href={channelUrl} target="_blank" rel="noopener noreferrer" data-channel-cta>
                جزئیات و درخواست <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        </div>
        <p class="section-footnote">در این مرحله، دکمه‌های محصولات به کانال اصلی تلگرام هدایت می‌شوند. صفحه‌های مستقل سفارش در مراحل بعدی فعال خواهند شد.</p>
      </div>
    </section>

    <section class="section section-process" id="how-to-order" aria-labelledby="process-title">
      <div class="container">
        <div class="section-heading">
          <p class="section-kicker">02 / HOW IT WORKS</p>
          <h2 id="process-title">چطور درخواست بدهم؟</h2>
          <p class="section-intro">سه گام ساده برای شروع؛ بدون پرداخت یا ثبت سفارش قطعی در سایت.</p>
        </div>

        <div class="process-track">
          <article class="process-step">
            <span class="process-number">01</span>
            <span class="process-icon process-icon-target" aria-hidden="true">⌖</span>
            <h3>انتخاب محصول</h3>
            <p>خدمت موردنظرتان را انتخاب کنید و اطلاعات اولیه مقصد را با دقت بررسی کنید.</p>
            <span class="process-step-foot">CHOOSE</span>
          </article>
          <article class="process-step">
            <span class="process-number">02</span>
            <span class="process-icon process-icon-send" aria-hidden="true">↗</span>
            <h3>ارسال درخواست</h3>
            <p>مسیر گفت‌وگو در تلگرام باز می‌شود. متن درخواست را خودتان برای پشتیبانی ارسال می‌کنید.</p>
            <span class="process-step-foot">CONTACT</span>
          </article>
          <article class="process-step">
            <span class="process-number">03</span>
            <span class="process-icon process-icon-check" aria-hidden="true">✓</span>
            <h3>قیمت و هماهنگی</h3>
            <p>قیمت نهایی، روش پرداخت و شرایط تحویل پس از بررسی با پشتیبانی هماهنگ می‌شود.</p>
            <span class="process-step-foot">CONFIRM</span>
          </article>
        </div>
        <div class="process-disclaimer"><span aria-hidden="true">i</span><p>بازشدن تلگرام به معنی ارسال پیام یا ثبت سفارش نیست؛ تا وقتی پیام را ارسال نکرده‌اید و پشتیبانی درخواست را نپذیرفته، سفارشی ثبت نشده است.</p></div>
      </div>
    </section>

    <section class="section section-orbit" aria-labelledby="orbit-title">
      <div class="container orbit-layout">
        <div class="orbit-copy">
          <p class="section-kicker">03 / THE NEXT DIMENSION</p>
          <h2 id="orbit-title">فراتر از یک<br /><span>تجربه معمولی.</span></h2>
          <p>این فضا برای تجربه‌های تعاملی آینده ORIGINAL NET در نظر گرفته شده است؛ جایی برای نمایش داده، حرکت و فناوری‌های تازه.</p>
          <span class="coming-soon"><i></i> فضای تعاملی در حال توسعه</span>
        </div>
        <div class="particle-stage" role="img" aria-label="نمایش آزمایشی گوی ذرات سه‌بعدی؛ نسخه تعاملی در مرحله بعد توسعه می‌یابد">
          <div class="particle-halo halo-a"></div>
          <div class="particle-halo halo-b"></div>
          <div class="particle-sphere">
            <span class="particle p01"></span><span class="particle p02"></span><span class="particle p03"></span><span class="particle p04"></span><span class="particle p05"></span><span class="particle p06"></span><span class="particle p07"></span><span class="particle p08"></span><span class="particle p09"></span><span class="particle p10"></span><span class="particle p11"></span><span class="particle p12"></span><span class="particle p13"></span><span class="particle p14"></span><span class="particle p15"></span><span class="particle p16"></span><span class="particle p17"></span><span class="particle p18"></span><span class="particle p19"></span><span class="particle p20"></span><span class="particle p21"></span><span class="particle p22"></span><span class="particle p23"></span><span class="particle p24"></span>
          </div>
          <span class="particle-caption particle-caption-top">PARTICLE FIELD / 001</span>
          <span class="particle-caption particle-caption-bottom">INTERACTIVE EXPERIENCE</span>
        </div>
      </div>
    </section>

    <section class="section section-clarity" id="why-original" aria-labelledby="clarity-title">
      <div class="container clarity-layout">
        <div class="clarity-heading">
          <p class="section-kicker">04 / OUR APPROACH</p>
          <h2 id="clarity-title">تجربه‌ای روشن،<br /><span>از انتخاب تا پیگیری.</span></h2>
          <p>در ORIGINAL NET تلاش می‌کنیم اطلاعات لازم، مسیر درخواست و راه ارتباطی را شفاف و قابل فهم نگه داریم؛ بدون وعده‌هایی که نتوانیم به آن‌ها عمل کنیم.</p>
          <a class="text-link" href={supportUrl} target="_blank" rel="noopener noreferrer">ارتباط مستقیم با پشتیبانی <span aria-hidden="true">↗</span></a>
        </div>
        <div class="clarity-list">
          <article class="clarity-item"><span class="clarity-item-number">01</span><div><h3>شفافیت اطلاعات</h3><p>پیش از ارسال درخواست، مسیر و اطلاعات موردنیاز مشخص است.</p></div><span class="clarity-item-symbol" aria-hidden="true">◈</span></article>
          <article class="clarity-item"><span class="clarity-item-number">02</span><div><h3>فرایند قابل فهم</h3><p>مراحل درخواست، پرداخت و هماهنگی از یکدیگر تفکیک شده‌اند.</p></div><span class="clarity-item-symbol" aria-hidden="true">⌁</span></article>
          <article class="clarity-item"><span class="clarity-item-number">03</span><div><h3>ارتباط مستقیم</h3><p>گفت‌وگوی مربوط به درخواست از مسیر پشتیبانی تلگرام انجام می‌شود.</p></div><span class="clarity-item-symbol" aria-hidden="true">↗</span></article>
          <article class="clarity-item"><span class="clarity-item-number">04</span><div><h3>حداقل‌سازی اطلاعات</h3><p>برای شروع درخواست، رمز عبور یا کد ورود تلگرام لازم نیست.</p></div><span class="clarity-item-symbol" aria-hidden="true">⌑</span></article>
        </div>
      </div>
    </section>

    <section class="section section-trust" id="trust" aria-labelledby="trust-title">
      <div class="container">
        <div class="section-heading section-heading-split">
          <div>
            <p class="section-kicker">05 / CUSTOMER EXPERIENCE</p>
            <h2 id="trust-title">اعتماد، با تجربه واقعی ساخته می‌شود.</h2>
            <p class="section-intro">این بخش برای نمایش تجربه‌های واقعی مشتریان آماده شده است.</p>
          </div>
          <div class="slider-controls" aria-label="کنترل اسلایدر تجربه مشتریان">
            <button type="button" class="slider-arrow" data-review-prev aria-label="کارت قبلی">←</button>
            <button type="button" class="slider-arrow" data-review-next aria-label="کارت بعدی">→</button>
          </div>
        </div>
        <p class="trust-notice">تا زمان دریافت بازخورد واقعی و اجازه انتشار، هیچ نام، امتیاز یا نقل‌قول ساختگی نمایش داده نمی‌شود. هفت جایگاه زیر برای محتوای تأییدشده آینده در نظر گرفته شده‌اند.</p>
        <div class="review-viewport" data-review-slider>
          <div class="review-track" data-review-track>
            {reviewSlots.map((slot, index) => (
              <article class="review-card review-card-placeholder" data-review-placeholder aria-label={`جایگاه بازخورد ${index + 1}`}>
                <span class="review-card-index">0{index + 1} / 07</span>
                <span class="review-quote-mark" aria-hidden="true">“</span>
                <h3>{slot}</h3>
                <p>پس از ثبت تجربه واقعی و دریافت اجازه صاحب آن، محتوای این کارت جایگزین می‌شود.</p>
                <span class="review-pending">در انتظار محتوای تأییدشده</span>
              </article>
            ))}
          </div>
        </div>
        <div class="review-foot"><span>07 / REVIEW SLOTS</span><span>بازخورد واقعی، نه عددسازی</span></div>
      </div>
    </section>

    <section class="section section-articles" id="articles" aria-labelledby="articles-title">
      <div class="container">
        <div class="section-heading section-heading-split">
          <div>
            <p class="section-kicker">06 / KNOWLEDGE</p>
            <h2 id="articles-title">مطالب منتخب</h2>
            <p class="section-intro">راهنماهایی برای انتخاب آگاهانه‌تر و استفاده بهتر از امکانات تلگرام.</p>
          </div>
          <span class="section-index">03 <i>/ 03</i></span>
        </div>
        <div class="article-grid">
          {articles.map((article) => (
            <article class="article-card">
              <div class={`article-art ${article.tone}`} aria-hidden="true">
                <span class="article-art-number">{article.number}</span>
                <span class="article-art-orbit"></span>
                <span class="article-art-label">ORIGINAL NET / JOURNAL</span>
              </div>
              <div class="article-card-content">
                <p class="article-category">{article.category}</p>
                <h3>{article.title}</h3>
                <span class="article-status">مقاله پس از آماده‌سازی و انتشار فعال می‌شود</span>
              </div>
            </article>
          ))}
        </div>
        <p class="section-footnote">این سه کارت فعلاً جایگاه موضوعات پیشنهادی هستند؛ تا زمان انتشار مقاله، لینک ساختگی یا صفحه خالی ایجاد نمی‌شود.</p>
      </div>
    </section>

    <section class="section section-cooperation" id="cooperation" aria-labelledby="cooperation-title">
      <div class="container">
        <div class="cooperation-card">
          <div class="cooperation-ornament" aria-hidden="true"><span>ON</span></div>
          <div class="cooperation-copy">
            <p class="section-kicker">07 / BUSINESS INQUIRY</p>
            <h2 id="cooperation-title">مدیر کانال یا گروه هستید؟</h2>
            <p>برای بررسی امکان همکاری، شرایط و جزئیات فعالیت خود را با پشتیبانی مطرح کنید. مسیر همکاری، جدا از درخواست خرید کاربران عادی بررسی می‌شود.</p>
            <div class="cooperation-actions">
              <button class="button button-primary" type="button" data-open-cooperation>مشاهده چارچوب همکاری <span aria-hidden="true">↗</span></button>
              <a class="button button-ghost" href={supportUrl} target="_blank" rel="noopener noreferrer">گفت‌وگو با پشتیبانی</a>
            </div>
          </div>
          <span class="cooperation-side-label">PARTNERSHIP / 07</span>
        </div>
      </div>
    </section>

    <section class="section section-faq" id="faq" aria-labelledby="faq-title">
      <div class="container faq-layout">
        <div class="faq-intro">
          <p class="section-kicker">08 / FAQ</p>
          <h2 id="faq-title">پرسش‌های<br /><span>متداول.</span></h2>
          <p>پاسخ پرسش‌های مهم پیش از ارسال درخواست را اینجا بخوانید.</p>
          <a class="text-link" href={supportUrl} target="_blank" rel="noopener noreferrer">پرسش دیگری دارید؟ <span aria-hidden="true">↗</span></a>
        </div>
        <div class="faq-list">
          {faqs.map((faq, index) => (
            <details class="faq-item">
              <summary><span class="faq-number">0{index + 1}</span><span>{faq.q}</span><span class="faq-plus" aria-hidden="true">+</span></summary>
              <div class="faq-answer"><p>{faq.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

